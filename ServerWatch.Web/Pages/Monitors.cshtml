@page
@model MonitorsModel
@{ViewData["Title"]="Monitors";}
<div class="page-title"><div class="eyebrow">// CONFIGURATION</div><h1>Monitors</h1><p>Add targets, set failure thresholds, trigger checks immediately and configure alerts.</p></div>
@if(TempData["Message"] is string message){<div class="notice">@message</div>}
<section class="form-panel"><h2>Add monitor</h2><form method="post" class="monitor-form phase3-form"><label>Name<input asp-for="Input.Name" placeholder="WEB-01" required/></label><label>Host / URL<input asp-for="Input.Host" placeholder="192.168.1.10 or https://example.com" required/></label><label>Check<select asp-for="Input.CheckType"><option>Ping</option><option>TCP</option><option>HTTP</option><option>SQL</option></select></label><label>Port<input asp-for="Input.Port" placeholder="443"/></label><label>Every (sec)<input asp-for="Input.IntervalSeconds" min="10" value="60"/></label><label>Timeout<input asp-for="Input.TimeoutSeconds" min="1" value="5"/></label><label>Fail after<input asp-for="Input.FailureThreshold" min="1" max="20" value="3"/></label><label class="connection-field">SQL connection string (optional)<input asp-for="Input.ConnectionString" type="password" autocomplete="new-password" placeholder="Uses Windows authentication when left blank"/></label><button>ADD MONITOR</button></form><p class="form-help">A monitor enters Warning after the first failed check and becomes Unhealthy only when its failure threshold is reached.</p></section>
<section class="panel monitor-list">@foreach(var t in Model.Targets){<div class="monitor-card"><div><b class="dot @(t.Enabled?"pending":"disabled")"></b><strong>@t.Name</strong><code>@t.Host</code></div><div><span>@t.CheckType @(t.Port is null?"":$":{t.Port}") · @t.IntervalSeconds sec · fail ×@t.FailureThreshold</span><form method="post" asp-page-handler="Run"><input type="hidden" name="id" value="@t.Id"/><button>RUN NOW</button></form><a class="secondary link-button" href="/EditMonitor?id=@t.Id">EDIT</a><form method="post" asp-page-handler="Toggle"><input type="hidden" name="id" value="@t.Id"/><button class="secondary">@(t.Enabled?"PAUSE":"ENABLE")</button></form><a class="secondary link-button" href="/History?id=@t.Id">HISTORY</a><form method="post" asp-page-handler="Delete" onsubmit="return confirm('Delete this monitor and all its history?')"><input type="hidden" name="id" value="@t.Id"/><button class="danger">DELETE</button></form></div></div>}</section>
