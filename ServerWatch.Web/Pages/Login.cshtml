@page
@model LoginModel
@{ViewData["Title"]="Sign in";}
<div class="login-wrap"><section class="form-panel login-panel"><div class="eyebrow">// SECURE CONSOLE</div><h1>Sign in</h1><p>Administrator access is required.</p>@if(Model.Error is not null){<div class="login-error">@Model.Error</div>}<form method="post"><label>Username<input asp-for="Username" autocomplete="username" required/></label><label>Password<input asp-for="Password" type="password" autocomplete="current-password" required/></label><button>SIGN IN</button></form></section></div>
