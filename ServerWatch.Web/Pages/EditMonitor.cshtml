@page
@model EditMonitorModel
@{ViewData["Title"]="Edit monitor";}
<div class="page-title"><div class="eyebrow">// MONITOR SETTINGS</div><h1>Edit @Model.Input.Name</h1><p>Configure monitoring behaviour and failure/recovery notifications.</p></div>
<section class="form-panel"><form method="post" class="edit-form"><input type="hidden" asp-for="Input.Id"/><label>Name<input asp-for="Input.Name" required/></label><label>Host / URL<input asp-for="Input.Host" required/></label><label>Check<select asp-for="Input.CheckType"><option>Ping</option><option>TCP</option><option>HTTP</option><option>SQL</option></select></label><label>Port<input asp-for="Input.Port"/></label><label>Interval seconds<input asp-for="Input.IntervalSeconds" min="10"/></label><label>Timeout seconds<input asp-for="Input.TimeoutSeconds" min="1"/></label><label>Consecutive failures before alert<input asp-for="Input.FailureThreshold" min="1" max="20"/></label><label>Email recipient<input asp-for="Input.AlertEmail" type="email" placeholder="ops@example.com"/></label><label>Webhook URL<input asp-for="Input.WebhookUrl" type="url" placeholder="https://..."/></label><label>New SQL connection string<input asp-for="Input.ConnectionString" type="password" placeholder="Leave blank to retain current value"/></label><label class="check-label"><input asp-for="Input.AlertsEnabled"/> Enable failure and recovery alerts</label><div class="form-actions"><button>SAVE CHANGES</button><a class="secondary link-button" href="/Monitors">CANCEL</a></div></form></section>
