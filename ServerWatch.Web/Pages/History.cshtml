@page
@model HistoryModel
@{ViewData["Title"]="History";}
@if(Model.Target is null){<div class="page-title"><h1>Monitor not found</h1><a class="button" href="/">BACK TO DASHBOARD</a></div>}
else{<div class="page-title"><div class="eyebrow">// CHECK HISTORY</div><h1>@Model.Target.Name</h1><p><code>@Model.Target.Host</code> · @Model.Target.CheckType · latest 100 checks</p></div>
<section class="stats history-stats"><article><small>UPTIME</small><strong>@Model.UptimePercent.ToString("0.0")%</strong><span>displayed checks</span></article><article><small>CHECKS</small><strong>@Model.Results.Count</strong><span>results retained here</span></article><article><small>AVERAGE</small><strong>@(Model.Results.Any(x=>x.ResponseTimeMs.HasValue)?$"{Model.Results.Where(x=>x.ResponseTimeMs.HasValue).Average(x=>x.ResponseTimeMs!.Value):0} ms":"—")</strong><span>response time</span></article><article><small>INTERVAL</small><strong>@Model.Target.IntervalSeconds s</strong><span>configured frequency</span></article></section>
@if(Model.ChartResults.Count>1){<section class="chart-panel"><div class="section-title"><div><span>// RESPONSE TIME</span><h2>Latest checks</h2></div></div><div class="bar-chart">@foreach(var r in Model.ChartResults){var height=Math.Max(4,(r.ResponseTimeMs!.Value*100)/Model.ChartMax);<div class="bar @(r.IsSuccessful?"":"bar-failed")" style="height:@(height)%" title="@($"{r.CheckedUtc.ToLocalTime():g}: {r.ResponseTimeMs} ms")"></div>}</div></section>}
<section class="panel history-table"><div class="history-head"><span>STATUS</span><span>CHECKED</span><span>RESPONSE</span><span>MESSAGE</span></div>@foreach(var r in Model.Results){<div class="history-row"><span><b class="dot @(r.Status=="Healthy"?"online":r.Status=="Warning"?"warning":"offline")"></b>@r.Status.ToUpperInvariant()</span><time>@r.CheckedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</time><span>@(r.ResponseTimeMs is null?"—":$"{r.ResponseTimeMs} ms")</span><span title="@r.Message">@r.Message</span></div>}</section>}
